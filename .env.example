# Copy to .env and replace this password before starting.
# Use URL-safe characters (for example: openssl rand -hex 24).
POSTGRES_USER=scanner
POSTGRES_DB=scanner
POSTGRES_PASSWORD=replace-with-a-random-password
# A unique Compose project name avoids reusing an existing installation's volume.
COMPOSE_PROJECT_NAME=webscanner-local
WEBSCANNER_PORT=3000
